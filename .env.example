# Copy to .env and fill in. Every variable here is read by server.py, the
# compose file or tools/simulate-signal.

# The MQTT broker the ESP32 publishes to. "mosquitto" is the bundled broker
# (docker compose --profile broker); point MQTT_HOST at your own otherwise.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=plantpulse
MQTT_PASS=change-me

# Where tools/fetch-samples put the web packs (inside the container).
PLANTPULSE_SAMPLES_DIR=/app/samples
