#!/usr/bin/env python3
"""simulate-signal: a fake plant on the wire, for a trial with no hardware.

Publishes volts to plantpulse/sensor/plant_signal/state at 4 Hz, the way the
ESP32 does, so the whole chain (broker, Flask SSE, the browser composer) runs
as it would with a leaf on the clips. The signal is shaped so the composer's
ranks have something to rank: a slow diurnal drift, a random walk, pink-ish
noise, and bursts whose rate rises and falls over the hours (a lively
afternoon, a quiet night). It is not a plant; it is enough to hear the rooms.

    tools/simulate-signal                 # MQTT_* from the environment (.env)
    tools/simulate-signal --hours 0.5     # a faster day, for testing the ranks
    tools/simulate-signal --dry-run       # print instead of publishing

`docker compose --profile demo up` runs it as a service.
"""
import argparse, math, os, random, sys, time


def make_signal(day_seconds):
    """Returns f(t_seconds) -> volts. Keeps its own walk state."""
    state = {"walk": 0.0, "burst": 0.0, "pink": [0.0] * 5}

    def pink():
        # a cheap 1/f: five one-pole stages at spread rates, summed
        p = state["pink"]
        w = random.gauss(0, 1)
        for i, a in enumerate((0.02, 0.06, 0.15, 0.35, 0.7)):
            p[i] += (w - p[i]) * a
        return sum(p) / 5.0

    def f(t):
        day = (t % day_seconds) / day_seconds            # 0..1, one "day"
        diurnal = 0.012 * math.sin(2 * math.pi * (day - 0.25))   # peaks mid-day
        liveliness = 0.5 + 0.5 * math.sin(2 * math.pi * (day - 0.2))  # lively afternoon, quiet night
        state["walk"] += random.gauss(0, 0.00025)
        state["walk"] *= 0.999
        if random.random() < 0.004 + 0.05 * liveliness ** 3:
            state["burst"] = random.choice((-1, 1)) * random.uniform(0.008, 0.04) * (0.4 + liveliness)
        state["burst"] *= 0.90
        noise = pink() * (0.0015 + 0.004 * liveliness)
        return 0.05 + diurnal + state["walk"] + state["burst"] + noise

    return f


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--host", default=os.environ.get("MQTT_HOST", "localhost"))
    ap.add_argument("--port", type=int, default=int(os.environ.get("MQTT_PORT", 1883)))
    ap.add_argument("--user", default=os.environ.get("MQTT_USER", "plantpulse"))
    ap.add_argument("--password", default=os.environ.get("MQTT_PASS", ""))
    ap.add_argument("--topic", default="plantpulse/sensor/plant_signal/state")
    ap.add_argument("--rate", type=float, default=4.0, help="readings per second (the ESP32 sends 4)")
    ap.add_argument("--hours", type=float, default=24.0, help="length of the simulated day")
    ap.add_argument("--dry-run", action="store_true", help="print the values instead of publishing")
    a = ap.parse_args()

    signal = make_signal(a.hours * 3600.0)
    client = None
    if not a.dry_run:
        import paho.mqtt.client as mqtt
        client = mqtt.Client(client_id=f"plantpulse-sim-{os.getpid()}")
        if a.user:
            client.username_pw_set(a.user, a.password)
        client.reconnect_delay_set(min_delay=1, max_delay=30)
        client.connect_async(a.host, a.port, keepalive=60)
        client.loop_start()
        print(f"[simulate-signal] publishing to {a.host}:{a.port} {a.topic} at {a.rate:g} Hz", flush=True)

    t0 = time.monotonic()
    period = 1.0 / a.rate
    n = 0
    try:
        while True:
            t = time.monotonic() - t0
            v = signal(t)
            payload = f"{v:.6f}"
            if client is None:
                print(payload, flush=True)
            else:
                client.publish(a.topic, payload)
            n += 1
            time.sleep(max(0.0, t0 + n * period - time.monotonic()))
    except KeyboardInterrupt:
        pass
    finally:
        if client is not None:
            client.loop_stop()


if __name__ == "__main__":
    main()
