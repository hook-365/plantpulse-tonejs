#!/bin/sh
# broker-password: write the bundled broker's password file from MQTT_USER /
# MQTT_PASS in .env (docker compose --profile broker). Mosquitto refuses a
# password file it cannot read and runs as its own user inside the container,
# so the file is created and owned there, not on the host.
#   tools/broker-password            # after editing .env; re-run to change it
set -e
cd "$(dirname "$0")/.."
[ -f .env ] || { echo "no .env (cp .env.example .env first)"; exit 1; }
set -a; . ./.env; set +a
: "${MQTT_PASS:?set MQTT_PASS in .env}"
docker compose "$@" run --rm --no-deps --user root mosquitto sh -c \
  "mosquitto_passwd -c -b /mosquitto/config/passwd '${MQTT_USER:-plantpulse}' '$MQTT_PASS' && chown mosquitto:mosquitto /mosquitto/config/passwd && chmod 600 /mosquitto/config/passwd"
echo "password set for ${MQTT_USER:-plantpulse}; restart the broker if it is running: docker compose --profile broker restart mosquitto"
